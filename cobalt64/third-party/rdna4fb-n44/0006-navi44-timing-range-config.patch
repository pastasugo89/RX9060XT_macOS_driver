+// An OpenCore DeviceProperties value as an unsigned integer: Data (little-endian, 1, 2, 4 or 8 bytes) or a Number.
+static bool rdna4_prop_uint(IORegistryEntry *dev, const char *key, uint64_t *out) {
+	OSObject *o = dev->getProperty(key);
+	if (!o)
+		return false;
+	if (OSNumber *n = OSDynamicCast(OSNumber, o)) {
+		*out = n->unsigned64BitValue();
+		return true;
+	}
+	OSData *d = OSDynamicCast(OSData, o);
+	if (!d)
+		return false;
+	const unsigned len = d->getLength();
+	if (len != 1 && len != 2 && len != 4 && len != 8)
+		return false;
+	const uint8_t *p = static_cast<const uint8_t *>(d->getBytesNoCopy());
+	uint64_t v = 0;
+	for (unsigned i = 0; i < len; i++)
+		v |= static_cast<uint64_t>(p[i]) << (8 * i);
+	*out = v;
+	return true;
+}
+
+static bool rdna4_prop_flag(IORegistryEntry *dev, const char *key) {
+	if (OSBoolean *b = OSDynamicCast(OSBoolean, dev->getProperty(key)))
+		return b->isTrue();
+	uint64_t v = 0;
+	return rdna4_prop_uint(dev, key, &v) && v != 0;
+}
+
+// The whole structure, if rdna4fb-tr-blob is present with exactly 0x138 bytes and passes the same limits.
+static bool rdna4_tr_blob(IORegistryEntry *dev, IODisplayTimingRangeV2 *r) {
+	OSData *blob = OSDynamicCast(OSData, dev->getProperty("rdna4fb-tr-blob"));
+	if (!blob)
+		return false;
+	if (blob->getLength() != sizeof(IODisplayTimingRangeV2)) {
+		FBLOG("rdna4fb-tr-blob refused: %u bytes, need %lu (default kept)", blob->getLength(),
+		      (unsigned long)sizeof(IODisplayTimingRangeV2));
+		return false;
+	}
+	IODisplayTimingRangeV2 b;
+	bcopy(blob->getBytesNoCopy(), &b, sizeof(b));
+	if (const char *why = rdna4_range_refusal(b)) {
+		FBLOG("rdna4fb-tr-blob refused: %s (default kept)", why);
+		return false;
+	}
+	*r = b;
+	FBLOG("rdna4fb-tr-blob applied: the whole structure");
+	return true;
+}
+
+typedef void (*RDNA4TRSetter)(IODisplayTimingRangeV2 &, uint64_t);
+
+// One scalar key. Applied only if it fits its type and the result passes rdna4_range_refusal; otherwise logged and skipped.
+static bool rdna4_tr_apply(IORegistryEntry *dev, IODisplayTimingRangeV2 *r, const char *key, uint64_t typeMax,
+                           RDNA4TRSetter set) {
+	uint64_t v = 0;
+	if (!rdna4_prop_uint(dev, key, &v))
+		return false;
+	if (v > typeMax) {
+		FBLOG("%s = %llu refused: does not fit its type (default kept)", key, (unsigned long long)v);
+		return false;
+	}
+	IODisplayTimingRangeV2 cand = *r;
+	set(cand, v);
+	if (const char *why = rdna4_range_refusal(cand)) {
+		FBLOG("%s = %llu refused: %s (default kept)", key, (unsigned long long)v, why);
+		return false;
+	}
+	*r = cand;
+	FBLOG("%s = %llu applied", key, (unsigned long long)v);
+	return true;
+}
