diff --git a/src/amd/common/darwin/ac_darwin_asic.h b/src/amd/common/darwin/ac_darwin_asic.h
new file mode 100644
index 00000000000..6d7e89812e0
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_asic.h
@@ -0,0 +1,32 @@
+/*
+ * Copyright © 2026 rx9060xt_metal_driver contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * ASIC profile of the Darwin backend: must match the kext build
+ * (make ASIC=navi44|navi48). Default: Navi 44 (RX 9060 XT, gfx1200).
+ * Build with -DRADV_DARWIN_NAVI48 for Navi 48 (RX 9070 XT / R9700, gfx1201).
+ *
+ * The canned record only seeds what the kext does not report; it must be the
+ * record of the real chip, because num_shader_engines / cu_bitmap /
+ * enabled_rb_pipes_mask drive CU masks and per-SE ring sizes (a gfx1201
+ * record on a Navi 44 would describe 2 SE and 32 CU that do not exist).
+ */
+#ifndef AC_DARWIN_ASIC_H
+#define AC_DARWIN_ASIC_H
+
+#ifdef RADV_DARWIN_NAVI48
+#define ACD_CANNED_NAME     "gfx1201"
+#define ACD_PCI_DEVICE_ID   0x7550
+#define ACD_PCI_SUBVENDOR   0x1002
+#define ACD_PCI_SUBDEVICE   0x0000
+#define ACD_MARKETING_NAME  "AMD Radeon RX 9070 XT"   /* amdgpu.ids: 7550,C0 */
+#else
+#define ACD_CANNED_NAME     "gfx1200"
+#define ACD_PCI_DEVICE_ID   0x7590
+#define ACD_PCI_SUBVENDOR   0x1002
+#define ACD_PCI_SUBDEVICE   0x0000
+#define ACD_MARKETING_NAME  "AMD Radeon RX 9060 XT"   /* amdgpu.ids: 7590,C0 */
+#endif
+#define ACD_PCI_REVISION    0xC0
+
+#endif
