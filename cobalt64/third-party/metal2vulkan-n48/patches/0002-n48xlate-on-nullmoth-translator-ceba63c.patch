+/// How the call site in [`raw_call_offset_ll`] derives the byte cursor it hands to the helper.
+#[derive(Clone, Copy)]
+enum RawCallCursor {
+    /// `getelementptr i8, %buffer0, N` (N constant).
+    Const(u32),
+    /// `getelementptr i8, %buffer0, %w` with `%w` loaded from the buffer at run time.
+    Dynamic,
+}
+
+/// A kernel that hands a byte-offset constant-space pointer to a multi-block (LOOP) helper which
+/// reads the second column of a typed `%mat` through it. `helper_first` places the helper BEFORE the
+/// kernel in module order (the Core Image shape); `via_builder` routes the pointer through a
+/// single-block aggregate builder first, instead of passing it directly.
+fn raw_call_offset_ll(cursor: RawCallCursor, helper_first: bool, via_builder: bool) -> String {
+    let cursor_def = match cursor {
+        RawCallCursor::Const(n) => format!("  %cursor = getelementptr i8, ptr addrspace(2) %buffer0, i64 {n}"),
+        RawCallCursor::Dynamic => "  %w = load i32, ptr addrspace(2) %o148, align 4\n  %wi = zext i32 %w to i64\n  %cursor = getelementptr i8, ptr addrspace(2) %buffer0, i64 %wi".to_string(),
+    };
+    let call = if via_builder {
+        r#"  %built = call fastcc %S @build(ptr addrspace(1) %out, ptr addrspace(2) %buffer0, ptr addrspace(2) %alias, <2 x float> zeroinitializer)
+  %f0 = extractvalue %S %built, 0
+  %f1 = extractvalue %S %built, 1
+  %f2 = extractvalue %S %built, 2
+  %f3 = extractvalue %S %built, 3
+  %v = call fastcc <4 x float> @consume(%tex %f0, %smp %f1, ptr addrspace(2) %f2, <2 x float> %f3)"#
+    } else {
+        "  %v = call fastcc <4 x float> @consume(%tex zeroinitializer, %smp zeroinitializer, ptr addrspace(2) %alias, <2 x float> zeroinitializer)"
+    };
+    let kernel = format!(
+        r#"define void @k(ptr addrspace(2) %buffer0, ptr addrspace(1) %out) {{
+entry:
+  %o144 = getelementptr i8, ptr addrspace(2) %buffer0, i64 144
+  %l144 = load float, ptr addrspace(2) %o144, align 4
+  %o148 = getelementptr i8, ptr addrspace(2) %buffer0, i64 148
+{cursor_def}
