+// The OTG0 readback. The register holds total - 1: 1524 is the 120 Hz timing, 3049 the 60 Hz timing.
+static void test_readback() {
+    CHECK_EQ(R::kOtg0VTotalByteOffset, 0x4FEFu * 4u);   // absolute dword 0x4FEF, the kernel side's kRegVTotal
+    CHECK_EQ(R::v_total_reg_for_hz(120), 0x5F4);
+    CHECK_EQ(R::v_total_reg_for_hz(60), 0xBE9);
+    CHECK_EQ(R::hz_from_vtotal_reg(0x5F4u), 120);
+    CHECK_EQ(R::hz_from_vtotal_reg(0xBE9u), 60);
+    // Anything else names no timing: the neighbours of both, the totals themselves, zero, and the all-ones read.
+    const uint32_t other[] = {0u, 1u, 1523u, 0x5F3u, 0x5F5u, 1525u, 3048u, 0xBE8u, 0xBEAu, 3050u,
+                              0x7FFFu, 0x80000000u, 0x800005F4u, 0xFFFFFFFFu};
+    for (uint32_t r : other)
+        CHECK_EQ(R::hz_from_vtotal_reg(r), 0);
+}
+
+// refresh_from_timing: pixel clock / (H total * V total), rounded. The two Navi 44 timings give 120 and 60.
+static void test_refresh_from_timing() {
+    CHECK_EQ(R::refresh_from_timing(497750000u, 2720u, 1525u), 120);
+    CHECK_EQ(R::refresh_from_timing(497750000u, 2720u, 3050u), 60);
+    CHECK_EQ(R::refresh_from_timing(0u, 2720u, 1525u), 0);
+    CHECK_EQ(R::refresh_from_timing(497750000u, 0u, 1525u), 0);
+    const uint32_t rates[] = {60u, 120u};
+    for (uint32_t hz : rates) {
+        const R::ScanoutTiming t = R::scanout_timing_for_hz(hz);
+        CHECK_EQ(R::refresh_from_timing(t.pixelClockHz, t.hActive + t.hBlanking, t.vActive + t.vBlanking), hz);
+    }
+}
+
+// combine_hz: the OTG readback (0 = unknown) and the Navi48,RefreshHz property. Navi 44 reports 60 Hz only when the
+// known sources say so.
+static void test_combine() {
+    const uint32_t n44 = 0x7590u, n48 = 0x7550u;
+    // Neither known: the 0.0.8 value (boot, and after a revert).
+    CHECK_EQ(R::combine_hz(0u, false, 0, n44), 120);
+    // Only the readback known: the scanout itself, with or without the property.
+    CHECK_EQ(R::combine_hz(120u, false, 0, n44), 120);
+    CHECK_EQ(R::combine_hz(60u, false, 0, n44), 60);
+    // Only the property known: the 0.0.9 rule (readback unavailable).
+    CHECK_EQ(R::combine_hz(0u, true, 60, n44), 60);
+    CHECK_EQ(R::combine_hz(0u, true, 120, n44), 120);
+    // Both known and equal.
+    CHECK_EQ(R::combine_hz(60u, true, 60, n44), 60);
+    CHECK_EQ(R::combine_hz(120u, true, 120, n44), 120);
+    // Both known and different: 120 Hz, in either direction.
+    CHECK_EQ(R::combine_hz(120u, true, 60, n44), 120);
+    CHECK_EQ(R::combine_hz(60u, true, 120, n44), 120);
+    // A junk property is absent; a readback that is not 60 or 120 is unknown.
+    CHECK_EQ(R::combine_hz(0u, true, 7, n44), 120);
+    CHECK_EQ(R::combine_hz(60u, true, (1ull << 32) | 60ull, n44), 60);
+    CHECK_EQ(R::combine_hz(0u, true, (1ull << 32) | 60ull, n44), 120);
+    CHECK_EQ(R::combine_hz(90u, false, 0, n44), 120);
+    CHECK_EQ(R::combine_hz(90u, true, 60, n44), 60);
+    // Navi 48 keeps 60 Hz whatever either source says.
+    CHECK_EQ(R::combine_hz(120u, false, 0, n48), 60);
+    CHECK_EQ(R::combine_hz(60u, true, 120, n48), 60);
+    CHECK_EQ(R::combine_hz(0u, false, 0, n48), 60);
+    // active_hz is the combination without a readback.
+    CHECK_EQ(R::active_hz(false, 0, n44), R::combine_hz(0u, false, 0, n44));
+    CHECK_EQ(R::active_hz(true, 60, n44), R::combine_hz(0u, true, 60, n44));
+}
