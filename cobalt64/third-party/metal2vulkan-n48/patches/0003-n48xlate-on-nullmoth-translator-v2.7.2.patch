+    let a = linked(ENTRY, &[("add_one", ADD_ONE)]);
+    let b = linked(ENTRY, &[("add_one", ADD_TWO)]);
+    assert_eq!((a.rc, b.rc), (0, 0), "{} {}", a.msg, b.msg);
+    assert_ne!(a.spv, b.spv);
