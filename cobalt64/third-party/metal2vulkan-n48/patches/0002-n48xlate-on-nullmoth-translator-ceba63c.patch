+
+/// Translate `ll` and return every constant word index of every `uint` storage-buffer access
+/// chain in program order, or the translation error.
+fn raw_call_offset_words(ll: &str, tag: &str) -> Result<Vec<String>, String> {
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_raw_call_offset_{}_{tag}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let result = crate::translate_sanitized_native(ll, Stage::Kernel, &tmp);
+    let _ = std::fs::remove_dir_all(&tmp);
+    let spv = result.map_err(|e| format!("{e}"))?;
+    let asm = disassemble(&spv).expect("disassemble");
+    assert!(!asm.contains(" Private"), "{asm}");
+    let words = |line: &str| {
+        line.split_whitespace()
+            .map(str::to_string)
+            .collect::<Vec<_>>()
+    };
+    let uint_ty = asm
+        .lines()
+        .map(words)
+        .find(|w| {
+            w.get(2).is_some_and(|op| op == "OpTypeInt")
+                && w.get(3..) == Some(&["32".into(), "0".into()][..])
+        })
+        .map(|w| w[0].clone())
+        .expect("uint type");
+    let uint_ptrs = asm
+        .lines()
+        .map(words)
+        .filter(|w| {
+            w.get(2).is_some_and(|op| op == "OpTypePointer")
+                && w.get(3).is_some_and(|sc| sc == "StorageBuffer")
+                && w.get(4) == Some(&uint_ty)
+        })
+        .map(|w| w[0].clone())
+        .collect::<Vec<_>>();
+    let constants = asm
+        .lines()
+        .map(words)
+        .filter(|w| w.get(2).is_some_and(|op| op == "OpConstant") && w.get(3) == Some(&uint_ty))
+        .map(|w| (w[0].clone(), w[4].clone()))
+        .collect::<HashMap<_, _>>();
+    Ok(asm
+        .lines()
+        .map(words)
+        .filter(|w| {
+            w.get(2).is_some_and(|op| op.ends_with("AccessChain")) && uint_ptrs.contains(&w[3])
+        })
+        .filter_map(|w| constants.get(w.last()?).cloned())
+        .collect())
+}
+
+fn expect_raw_call_offset_words(cursor_bytes: u32, helper_first: bool, via_builder: bool) {
+    let ll = raw_call_offset_ll(
+        RawCallCursor::Const(cursor_bytes),
+        helper_first,
+        via_builder,
+    );
+    let tag = format!("c{cursor_bytes}_{helper_first}_{via_builder}");
+    let first_col = cursor_bytes / 4 + 4;
+    let want = ["36"]
+        .into_iter()
+        .map(str::to_string)
+        .chain((first_col..first_col + 4).map(|w| w.to_string()))
+        .collect::<Vec<_>>();
+    match raw_call_offset_words(&ll, &tag) {
+        Ok(words) => assert_eq!(
+            words, want,
+            "cursor {cursor_bytes} helper_first {helper_first} builder {via_builder}"
+        ),
+        Err(e) => {
+            panic!("cursor {cursor_bytes} helper_first {helper_first} builder {via_builder}: {e}")
+        }
+    }
+}
+
+#[test]
+fn native_raw_call_offset_reaches_loop_helper_defined_before_kernel() {
+    // 112 bytes + the second column (16 bytes) = words 32..=35; the helper's own typed offset 16
+    // must never collapse to the bare buffer's words 4..=7.
+    expect_raw_call_offset_words(112, true, true);
+}
+
+#[test]
+fn native_raw_call_offset_reaches_loop_helper_defined_after_kernel() {
+    expect_raw_call_offset_words(112, false, true);
+}
+
+#[test]
+fn native_raw_call_offset_reaches_loop_helper_passed_directly() {
+    expect_raw_call_offset_words(112, true, false);
+    expect_raw_call_offset_words(112, false, false);
+}
+
+#[test]
+fn native_raw_call_offset_80_reaches_loop_helper() {
+    expect_raw_call_offset_words(80, true, true);
+    expect_raw_call_offset_words(80, true, false);
+}
+
+#[test]
+fn native_raw_call_offset_is_delivered_or_refused_never_dropped() {
+    // A dynamic cursor, or any cursor the callee cannot receive, must either reach the helper's
+    // reads (a run-time-dependent access chain, never constant words 4..=7 of the bare buffer) or
+    // fail translation. It must never silently address the bare root.
+    for helper_first in [true, false] {
+        for via_builder in [true, false] {
+            let ll = raw_call_offset_ll(RawCallCursor::Dynamic, helper_first, via_builder);
+            let tag = format!("dyn_{helper_first}_{via_builder}");
+            if let Ok(words) = raw_call_offset_words(&ll, &tag) {
+                assert!(
+                    !["4", "5", "6", "7"].iter().all(|w| words.iter().any(|x| x == w)),
+                    "dynamic cursor dropped (helper_first {helper_first}, builder {via_builder}): {words:?}"
+                );
+            }
+        }
+    }
+}
