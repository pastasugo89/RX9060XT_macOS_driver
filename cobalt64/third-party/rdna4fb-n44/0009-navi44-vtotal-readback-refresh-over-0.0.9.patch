+    CHECK_EQ(R::combine_hz(hw60, true, 60, n44), 60);       // property published
+    CHECK_EQ(R::combine_hz(hw120, true, 60, n44), 120);     // restore: scanout back, property still 60
+    CHECK_EQ(R::combine_hz(hw120, true, 120, n44), 120);    // restored
+}
