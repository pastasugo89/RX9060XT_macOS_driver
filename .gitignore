# Sorgenti di riferimento e progetti di terzi (riscaricabili, troppo grandi)
/research/src/
/research/refs/
/research/ext/
# binari Apple estratti dall installer di macOS: solo analisi locale, mai nel repository
/research/macos/
# Firmware AMD: non versionati (licenza linux-firmware), vedi cobalt64/BUILDING.md
*.bin.zst
/cobalt64/src/navi48-bringup/firmware/
# Output di build
build/
*.o
*.kext/
.DS_Store

# collegamento locale ai sorgenti Linux, dove i test di Cobalt64 li cercano (re/linux-dc)
/cobalt64/re/
# ioaccel-layout: output derivato dalle kernel collection Apple (il symlink punta a research/ext/layout-out, gia ignorato)
/cobalt64/tools/ioaccel-layout/generated

# spvcache 25G83 generata in locale da shader Apple (SkyLight, CoreDisplay): non versionare, non ridistribuire
/research/ext/spvcache-25G83/

# bytecode Python (cache di import, rigenerata a ogni esecuzione)
__pycache__/
