new file mode 100644
index 0000000..c139c27
--- /dev/null
+++ b/src/amd/n4x_console_guard.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <stdint.h>
+namespace n4xconsole {
+enum Range { Invalid, Inside, Outside, Partial };
+inline bool geometry_valid(uint64_t width, uint64_t height, uint64_t depth, uint64_t rowBytes) {
+    if (!width || !height || width > 16384 || height > 16384 || depth < 8 || depth > 64) return false;
+    const uint64_t bytesPerPixel = (depth + 7) / 8;
+    return rowBytes >= width * bytesPerPixel && rowBytes <= (~uint64_t(0)) / height;
+}
+inline Range classify(uint64_t fb, uint64_t len, uint64_t bar, uint64_t size) {
+    const uint64_t max = ~uint64_t(0);
+    if (!fb || !len || !bar || !size || len > max - fb || size > max - bar) return Invalid;
+    const uint64_t fbEnd = fb + len, barEnd = bar + size;
+    if (fb >= bar && fbEnd <= barEnd) return Inside;
+    if (fb < barEnd && bar < fbEnd) return Partial;
+    return Outside;
+}
+}  // namespace n4xconsole
