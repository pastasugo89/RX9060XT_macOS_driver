+/// Port change (not in NullMoth): two independent switches for the bindless texture routing, set by
+/// the embedding (`metal2vulkan::set_bindless_routing`) instead of the environment. Both default to on,
+/// which is NullMoth's behaviour. `plain`: every non-buffer texture argument is routed through the
+/// bindless heap (this is what declares the BufferAddressTable for ordinary texture shaders).
+/// `arrays`: texture-array element access is routed through the heap (the array-element fix).
+static BINDLESS_PLAIN: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+static BINDLESS_ARRAYS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+pub fn set_bindless_switches(plain: bool, arrays: bool) {
+    BINDLESS_PLAIN.store(plain, std::sync::atomic::Ordering::SeqCst);
+    BINDLESS_ARRAYS.store(arrays, std::sync::atomic::Ordering::SeqCst);
+}
+pub(crate) fn bindless_plain_on() -> bool {
+    BINDLESS_PLAIN.load(std::sync::atomic::Ordering::SeqCst) && bindless_all_on()
+}
+pub(crate) fn bindless_arrays_on() -> bool {
+    BINDLESS_ARRAYS.load(std::sync::atomic::Ordering::SeqCst) && bindless_all_on()
+}
