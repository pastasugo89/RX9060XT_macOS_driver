# Sorgenti di riferimento e progetti di terzi (riscaricabili, troppo grandi)
/research/src/
/research/refs/
/research/ext/
# binari Apple estratti dall installer di macOS: solo analisi locale, mai nel repository
/research/macos/
# Firmware AMD: non versionati (licenza linux-firmware), vedi cobalt64/BUILDING.md
*.bin.zst
/cobalt64/src/navi48-bringup/firmware/
# Output di build
build/
*.o
*.kext/
.DS_Store

# collegamento locale ai sorgenti Linux, dove i test di Cobalt64 li cercano (re/linux-dc)
/cobalt64/re/
# ioaccel-layout: output derivato dalle kernel collection Apple (il symlink punta a research/ext/layout-out, gia ignorato)
/cobalt64/tools/ioaccel-layout/generated

# spvcache 25G83 generata in locale da shader Apple (SkyLight, CoreDisplay): non versionare, non ridistribuire
/research/ext/spvcache-25G83/

# bytecode Python (cache di import, rigenerata a ogni esecuzione)
__pycache__/

# EFI OpenCore per il bare metal: config con seriali generati, kext e tool di terze parti (licenze da verificare). Mai nel repository
/research/ext/ocboot-baremetal/

# Tabelle ACPI binarie della scheda madre dell utente (firmware MSI/AMI): restano locali
research/hw_dump/baremetal_inventory/acpi/

# Local build trees/toolchains and shader/firmware artifacts; source fixes live in cobalt64/ and tools/.
/research/builds/
# Extracted initramfs contents from local Linux bring-up (regenerable, not project source).
/VERSION
/bin
/sbin
/lib
/lib64
/etc/
/home/
/usr/
/var/
/init
/init_functions
/new_root/
/config
/buildconfig
/printf
/compute-metal.png
/quad-metal.png
# Captured Apple framework code and confidential generated EFI configuration stay local.
/research/hw_dump/**/*.bin
/research/hw_dump/**/config.plist

/new_root

# Proprietary or personal artefacts: never versioned (2026-11-12 cleanup)
*.rom
research/hw_dump/**/*.air
research/hw_dump/**/*.spv
*edid*.bin
