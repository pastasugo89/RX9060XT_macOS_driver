diff -ruN a/src/refresh_pure.h b/src/refresh_pure.h
--- a/src/refresh_pure.h	1970-01-01 01:00:00
+++ b/src/refresh_pure.h	2026-11-01 10:40:07
@@ -0,0 +1,93 @@
+//
+//  refresh_pure.h
+//  RDNA4FB
+//
+//  Pure helpers for the refresh of the one exposed mode: 60 Hz or 120 Hz on Navi 44 (0x7590).
+//  No kernel headers: tests/test_refresh_pure.cpp compiles this file on the host.
+//
+//  The refresh is the IORegistry property "Navi48,RefreshHz" on the PCI nub, an OSNumber written by
+//  the kernel side: 60 for the 60 Hz scanout, 120 on restore. Absent, or any other value, gives the
+//  0.0.8 default. Only Navi 44 honours the property: its 2560x1440 timing path is the only one that
+//  depends on the refresh.
+//
+//  Scanout timing (Navi 44): the pixel clock (497.75 MHz) and the horizontal timing (2560 + 160) are
+//  the same at both refreshes. Only the vertical blanking differs: 85 lines at 120 Hz (V total 1525,
+//  119.998 Hz) and 1610 lines at 60 Hz (V total 3050, 59.999 Hz). The sync position (3 + 10) is the same.
+//
+
+#pragma once
+
+#include <stdint.h>
+#include "vbl_period.h"
+
+namespace rdna4fb_refresh {
+
+constexpr uint32_t kNavi44DeviceId = 0x7590u;   // RX 9060 XT
+constexpr uint32_t kRefreshLowHz   = 60u;       // the value that selects the 60 Hz timing on Navi 44
+constexpr uint32_t kRefreshHighHz  = 120u;      // the 0.0.8 Navi 44 default
+
+// The 0.0.8 default for a PCI device id: 120 Hz on Navi 44, 60 Hz otherwise.
+constexpr uint32_t default_hz(uint32_t deviceId) {
+    return deviceId == kNavi44DeviceId ? kRefreshHighHz : kRefreshLowHz;
+}
+
+// Active refresh in Hz. present: the property exists and is an OSNumber. value: its unsigned 64-bit
+// value. On Navi 44 exactly 60 gives 60 and exactly 120 gives 120; everything else gives the default.
+// A 64-bit value that only truncates to 60 or 120 (such as 2^32 + 60) is junk.
+constexpr uint32_t active_hz(bool present, uint64_t value, uint32_t deviceId) {
+    return (present && deviceId == kNavi44DeviceId && value == kRefreshLowHz)  ? kRefreshLowHz
+         : (present && deviceId == kNavi44DeviceId && value == kRefreshHighHz) ? kRefreshHighHz
+         : default_hz(deviceId);
+}
+
+// VBL emulation period in microseconds, with the 0.0.8 rounding (rdna4_vbl_period_from_fixed).
+// 60 Hz: 16667 us. 120 Hz: 8333 us.
+inline unsigned int vbl_period_us(uint32_t hz) {
+    return rdna4_vbl_period_from_fixed(hz << 16);
+}
+
+// Vertical timing of the Navi 44 mode. The active lines and the sync position are the same at both refreshes.
+constexpr uint32_t kVActiveLines = 1440u;
+constexpr uint32_t kVSyncOffset  = 3u;
+constexpr uint32_t kVSyncPulse   = 10u;
+
+constexpr uint32_t v_blanking_for_hz(uint32_t hz) {
+    return hz == kRefreshLowHz ? 1610u : 85u;
+}
+
+constexpr uint32_t v_total_for_hz(uint32_t hz) {
+    return kVActiveLines + v_blanking_for_hz(hz);
+}
+
+// Scanout timing of the custom Navi 44 mode (the detailed timing, the GOP check and the timing range).
+struct ScanoutTiming {
+    uint32_t pixelClockHz;
+    uint32_t hActive, hBlanking, hSyncOffset, hSyncPulse;
+    uint32_t vActive, vBlanking, vSyncOffset, vSyncPulse;
+};
+
+constexpr uint32_t kPixelClockHz = 497750000u;   // 497.75 MHz at both refreshes
+
+constexpr ScanoutTiming scanout_timing_for_hz(uint32_t hz) {
+    return ScanoutTiming{kPixelClockHz, 2560u, 160u, 48u, 32u,
+                         kVActiveLines, v_blanking_for_hz(hz), kVSyncOffset, kVSyncPulse};
+}
+
+// The vertical blanking of a GOP-family timing: the session pruning accepts the timing of either refresh.
+constexpr bool is_gop_vertical_blanking(uint32_t vBlanking) {
+    return vBlanking == v_blanking_for_hz(kRefreshHighHz) || vBlanking == v_blanking_for_hz(kRefreshLowHz);
+}
+
+// The programmable timing range (IODisplayTimingRangeV2): frame rate +/- 1 Hz around the refresh, and the
+// vertical total and blanking of the one timing.
+struct RangeValues {
+    uint32_t minFrameRate, maxFrameRate;
+    uint32_t maxVerticalTotal;
+    uint32_t minVerticalBlanking, maxVerticalBlanking;
+};
+
+constexpr RangeValues range_for_hz(uint32_t hz) {
+    return RangeValues{hz - 1u, hz + 1u, v_total_for_hz(hz), v_blanking_for_hz(hz), v_blanking_for_hz(hz)};
+}
+
+}  // namespace rdna4fb_refresh
diff -ruN a/tests/test_refresh_pure.cpp b/tests/test_refresh_pure.cpp
--- a/tests/test_refresh_pure.cpp	1970-01-01 01:00:00
+++ b/tests/test_refresh_pure.cpp	2026-11-01 10:40:22
@@ -0,0 +1,192 @@
+//
+//  test_refresh_pure.cpp
+//  RDNA4FB
+//
+//  Host test of src/refresh_pure.h (plain asserts, no kernel headers). Build and run on the Mac:
+//    clang++ -std=c++17 -Wall -Wextra -Werror -I src tests/test_refresh_pure.cpp -o <dir>/test_refresh_pure
+//    <dir>/test_refresh_pure
+//  Exit status 0 when every check passes.
+//
+
+#include "refresh_pure.h"
+
+#include <cstdint>
+#include <cstdio>
+
+namespace R = rdna4fb_refresh;
+
+static int g_checks = 0;
+static int g_failures = 0;
+
+#define CHECK(cond)                                                                  \
+    do {                                                                             \
+        ++g_checks;                                                                  \
+        if (!(cond)) {                                                               \
+            ++g_failures;                                                            \
+            std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);              \
+        }                                                                            \
+    } while (0)
+
+#define CHECK_EQ(actual, expected)                                                   \
+    do {                                                                             \
+        ++g_checks;                                                                  \
+        const unsigned long long got_ = static_cast<unsigned long long>(actual);     \
+        const unsigned long long want_ = static_cast<unsigned long long>(expected);  \
+        if (got_ != want_) {                                                         \
+            ++g_failures;                                                            \
+            std::printf("FAIL %s:%d: %s = %llu, want %llu\n", __FILE__, __LINE__,    \
+                        #actual, got_, want_);                                       \
+        }                                                                            \
+    } while (0)
+
+// Property selection: absent, 60, 120, junk. Navi 44 is 0x7590, Navi 48 is 0x7550 and R9700 is 0x7551.
+static void test_property_selection() {
+    CHECK_EQ(R::default_hz(0x7590), 120);
+    CHECK_EQ(R::default_hz(0x7550), 60);
+    CHECK_EQ(R::default_hz(0x7551), 60);
+    CHECK_EQ(R::default_hz(0), 60);
+
+    // Absent: the 0.0.8 default, whatever the value that is passed with it.
+    CHECK_EQ(R::active_hz(false, 0, 0x7590), 120);
+    CHECK_EQ(R::active_hz(false, 60, 0x7590), 120);
+    CHECK_EQ(R::active_hz(false, 0, 0x7550), 60);
+    CHECK_EQ(R::active_hz(false, 0, 0x7551), 60);
+
+    // Navi 44: exactly 60 selects 60, exactly 120 selects 120.
+    CHECK_EQ(R::active_hz(true, 60, 0x7590), 60);
+    CHECK_EQ(R::active_hz(true, 120, 0x7590), 120);
+
+    // Junk on Navi 44: the default. Includes values that only truncate to 60 or 120 in 32 bits.
+    const uint64_t junk[] = {0, 1, 59, 61, 90, 119, 121, 240, 0xFFFFFFFFull,
+                             (1ull << 32) | 60ull, (1ull << 32) | 120ull, 1ull << 63, ~0ull};
+    for (uint64_t v : junk) {
+        CHECK_EQ(R::active_hz(true, v, 0x7590), 120);
+        CHECK_EQ(R::active_hz(true, v, 0x7550), 60);
+    }
+}
+
+// Navi 48 and R9700 keep 60 Hz whatever the property says: the custom timing path is Navi 44 only.
+static void test_navi48_ignores_property() {
+    CHECK_EQ(R::active_hz(true, 60, 0x7550), 60);
+    CHECK_EQ(R::active_hz(true, 120, 0x7550), 60);
+    CHECK_EQ(R::active_hz(true, 120, 0x7551), 60);
+    CHECK_EQ(R::active_hz(true, 60, 0x7551), 60);
+}
+
+static void test_vbl_period() {
+    CHECK_EQ(R::vbl_period_us(60), 16667);
+    CHECK_EQ(R::vbl_period_us(120), 8333);
+    // Same rounding as the 0.0.8 advertised-mode path (refresh in 16.16 fixed point).
+    CHECK_EQ(rdna4_vbl_period_from_fixed(60u << 16), 16667);
+    CHECK_EQ(rdna4_vbl_period_from_fixed(120u << 16), 8333);
+    // Absent property on Navi 44: the 0.0.8 period. Property 60: 16667 us.
+    CHECK_EQ(R::vbl_period_us(R::active_hz(false, 0, 0x7590)), 8333);
+    CHECK_EQ(R::vbl_period_us(R::active_hz(true, 60, 0x7590)), 16667);
+}
+
+static void test_vertical_totals() {
+    CHECK_EQ(R::v_blanking_for_hz(60), 1610);
+    CHECK_EQ(R::v_blanking_for_hz(120), 85);
+    CHECK_EQ(R::v_total_for_hz(60), 3050);
+    CHECK_EQ(R::v_total_for_hz(120), 1525);
+    CHECK_EQ(R::v_total_for_hz(R::active_hz(false, 0, 0x7590)), 1525);
+    CHECK_EQ(R::v_total_for_hz(R::active_hz(true, 60, 0x7590)), 3050);
+    CHECK(R::is_gop_vertical_blanking(85));
+    CHECK(R::is_gop_vertical_blanking(1610));
+    CHECK(!R::is_gop_vertical_blanking(84));
+    CHECK(!R::is_gop_vertical_blanking(86));
+    CHECK(!R::is_gop_vertical_blanking(1525));
+}
+
+// The 60 Hz variant keeps the pixel clock and the horizontal timing; only V blanking changes.
+static void test_scanout_timing() {
+    const R::ScanoutTiming t120 = R::scanout_timing_for_hz(120);
+    const R::ScanoutTiming t60 = R::scanout_timing_for_hz(60);
+
+    // The 0.0.8 120 Hz timing.
+    CHECK_EQ(t120.pixelClockHz, 497750000);
+    CHECK_EQ(t120.hActive, 2560);
+    CHECK_EQ(t120.hBlanking, 160);
+    CHECK_EQ(t120.hSyncOffset, 48);
+    CHECK_EQ(t120.hSyncPulse, 32);
+    CHECK_EQ(t120.vActive, 1440);
+    CHECK_EQ(t120.vBlanking, 85);
+    CHECK_EQ(t120.vSyncOffset, 3);
+    CHECK_EQ(t120.vSyncPulse, 10);
+
+    // The 60 Hz variant: same clock, same H timing, same V active and sync. Only V blanking differs.
+    CHECK_EQ(t60.pixelClockHz, t120.pixelClockHz);
+    CHECK_EQ(t60.hActive, t120.hActive);
+    CHECK_EQ(t60.hBlanking, t120.hBlanking);
+    CHECK_EQ(t60.hSyncOffset, t120.hSyncOffset);
+    CHECK_EQ(t60.hSyncPulse, t120.hSyncPulse);
+    CHECK_EQ(t60.vActive, t120.vActive);
+    CHECK_EQ(t60.vSyncOffset, t120.vSyncOffset);
+    CHECK_EQ(t60.vSyncPulse, t120.vSyncPulse);
+    CHECK_EQ(t60.vBlanking, 1610);
+    CHECK_EQ(t60.vActive + t60.vBlanking, 3050);
+    CHECK_EQ(t120.vActive + t120.vBlanking, 1525);
+
+    // The refresh each total gives, from the clock and the totals (integer arithmetic, milli-Hz).
+    const uint64_t hTotal = static_cast<uint64_t>(t60.hActive) + t60.hBlanking;   // 2720 at both refreshes
+    const uint64_t milliHz60 =
+        static_cast<uint64_t>(t60.pixelClockHz) * 1000ull / (hTotal * (t60.vActive + t60.vBlanking));
+    const uint64_t milliHz120 =
+        static_cast<uint64_t>(t120.pixelClockHz) * 1000ull / (hTotal * (t120.vActive + t120.vBlanking));
+    CHECK(milliHz60 >= 59000 && milliHz60 <= 61000);
+    CHECK(milliHz120 >= 119000 && milliHz120 <= 121000);
+
+    // Line rate: 183.0 kHz at both refreshes (the range allows 182800..183200 Hz).
+    const uint64_t line60 = static_cast<uint64_t>(t60.pixelClockHz) / hTotal;
+    const uint64_t line120 = static_cast<uint64_t>(t120.pixelClockHz) / hTotal;
+    CHECK(line60 >= 182800 && line60 <= 183200);
+    CHECK_EQ(line60, line120);
+}
+
+static void test_range() {
+    const R::RangeValues r120 = R::range_for_hz(120);
+    const R::RangeValues r60 = R::range_for_hz(60);
+
+    // The 0.0.8 range.
+    CHECK_EQ(r120.minFrameRate, 119);
+    CHECK_EQ(r120.maxFrameRate, 121);
+    CHECK_EQ(r120.maxVerticalTotal, 1525);
+    CHECK_EQ(r120.minVerticalBlanking, 85);
+    CHECK_EQ(r120.maxVerticalBlanking, 85);
+
+    // The 60 Hz range: 59..61 Hz, V total 3050, V blanking exactly the 60 Hz timing.
+    CHECK_EQ(r60.minFrameRate, 59);
+    CHECK_EQ(r60.maxFrameRate, 61);
+    CHECK_EQ(r60.maxVerticalTotal, 3050);
+    CHECK_EQ(r60.minVerticalBlanking, 1610);
+    CHECK_EQ(r60.maxVerticalBlanking, 1610);
+
+    // The absent-property path (and junk) keeps the 0.0.8 range.
+    const R::RangeValues absent = R::range_for_hz(R::active_hz(false, 0, 0x7590));
+    CHECK_EQ(absent.minFrameRate, 119);
+    CHECK_EQ(absent.maxVerticalTotal, 1525);
+    const R::RangeValues junk = R::range_for_hz(R::active_hz(true, 7, 0x7590));
+    CHECK_EQ(junk.maxVerticalTotal, 1525);
+}
+
+int main() {
+    test_property_selection();
+    test_navi48_ignores_property();
+    test_vbl_period();
+    test_vertical_totals();
+    test_scanout_timing();
+    test_range();
+
+    std::printf("Navi 44, property absent: %u Hz, VBL %u us, V total %u, range %u..%u Hz\n",
+                R::active_hz(false, 0, 0x7590), R::vbl_period_us(R::active_hz(false, 0, 0x7590)),
+                R::v_total_for_hz(R::active_hz(false, 0, 0x7590)),
+                R::range_for_hz(R::active_hz(false, 0, 0x7590)).minFrameRate,
+                R::range_for_hz(R::active_hz(false, 0, 0x7590)).maxFrameRate);
+    std::printf("Navi 44, property 60:     %u Hz, VBL %u us, V total %u, range %u..%u Hz\n",
+                R::active_hz(true, 60, 0x7590), R::vbl_period_us(R::active_hz(true, 60, 0x7590)),
+                R::v_total_for_hz(R::active_hz(true, 60, 0x7590)),
+                R::range_for_hz(R::active_hz(true, 60, 0x7590)).minFrameRate,
+                R::range_for_hz(R::active_hz(true, 60, 0x7590)).maxFrameRate);
+    std::printf("refresh_pure: %d checks, %d failures\n", g_checks, g_failures);
+    return g_failures == 0 ? 0 : 1;
+}
