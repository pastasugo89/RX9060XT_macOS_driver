+//      if (elapsed < 5 ms) IODelay(1); else IOSleep(1);
+//  i.e. up to 5 ms of pure busy-spin per wait, and ring_submit_production re-took gCliLock + gRingLock every 1 us of it. With 13+ GPU
+//  clients at login on 8 VMIDs that is most of WindowServer's 4:40 of system CPU in 18 minutes.
+//
+//  0.0.682 (boot-arg navi48-waitsleep, default 1):
+//    kSleep  (default) a 50 us spin, then a timed sleep whose length doubles from 50 us up to a cap: 200 us for fence and ring-space waits,
+//            1000 us for the production VMID retry (which no longer retakes the global locks more often than that). Every overall bound
+//            (kWaitCapNs, kHangNs, kG5WaitBoundNs, the caller's timeout) is unchanged: only the step inside the bound changes.
+//    kEop    (navi48-interrupts=2 with the IH delivering, see ih_storm_pure.h eop_wake_on) the same steps, but the sleep is on the EOP event:
+//            an end-of-pipe vector ends it early. The timeout is the polling fallback.
+//    kLegacy (navi48-waitsleep=0) exactly the 0.0.681 step: 1 us spin for 5 ms, then 1 ms sleeps.
+//  Why the sleep is safe without interrupts: every one of these loops already blocked (IOSleep(1)) after 5 ms, so each runs in a thread that
+//  may block with the locks it holds at that point; a timed sleep only moves that point to 50 us. Without an interrupt nothing ends the sleep
+//  early, so the cost is at most one step (<= 200 us for a fence) of extra latency per wait, against 5 ms of spinning.
+//
+#pragma once
+#include <stdint.h>
+
+namespace n48wait {
+
+enum Mode : uint32_t { kLegacy = 0u, kSleep = 1u, kEop = 2u };
+// navi48-waitsleep: absent or non-zero -> kSleep; 0 -> kLegacy. kEop is chosen at run time (the EOP wake on) and only over kSleep.
+constexpr uint32_t mode_of(bool present, uint32_t value, bool eopWake) {
+    return (present && value == 0u) ? (uint32_t)kLegacy : eopWake ? (uint32_t)kEop : (uint32_t)kSleep;
+}
+
+constexpr uint64_t kLegacySpinNs   = 5000000ull;   // 0.0.601..0.0.681: IODelay(1) for the first 5 ms
+constexpr uint64_t kSpinNs         = 50000ull;     // 0.0.682: spin at most 50 us
+constexpr uint32_t kFirstSleepUs   = 50u;
+constexpr uint32_t kFenceCapUs     = 200u;         // fence / ring-space waits: 50, 100, 200, 200, ...
+constexpr uint32_t kRetryCapUs     = 1000u;        // ring_submit_production's VMID / admission retry: 50 .. 1000
+
+enum Kind : uint32_t { kSpin1us = 0u, kSleepUs = 1u, kEventUs = 2u };
+struct Step { uint32_t kind; uint32_t us; };
+struct Backoff { uint32_t sleeps; };   // sleeps taken so far in this wait (the doubling exponent)
+
+constexpr uint32_t backoff_us(uint32_t sleeps, uint32_t capUs) {
+    return sleeps >= 5u ? capUs : (kFirstSleepUs << sleeps) > capUs ? capUs : (kFirstSleepUs << sleeps);
+}
+// The next step of a wait that has run `elapsedNs`. Advances b.sleeps when it plans a sleep.
+inline Step next_step(uint32_t mode, Backoff &b, uint64_t elapsedNs, uint32_t capUs) {
+    if (mode == kLegacy) return elapsedNs < kLegacySpinNs ? Step{ (uint32_t)kSpin1us, 1u } : Step{ (uint32_t)kSleepUs, 1000u };
+    if (elapsedNs < kSpinNs) return Step{ (uint32_t)kSpin1us, 1u };
+    const uint32_t us = backoff_us(b.sleeps, capUs);
+    if (b.sleeps < 32u) b.sleeps++;
+    return Step{ mode == kEop ? (uint32_t)kEventUs : (uint32_t)kSleepUs, us };
+}
+
+// ---- F1: the bound-expiry log ------------------------------------------------------------------------------------------------------------------------
+// Every expiry of a 2 s bound is logged with its caller, the wait kind and the seqnos. Rate limit: at most one line per kLogGapNs and kLogMax
+// lines per boot; the lines suppressed in between are counted and printed with the next line that passes.
+enum WaitKind : uint32_t { kOwnSeq = 0u, kRingSpace = 1u, kAdmission = 2u, kUserWait = 3u, kInternal = 4u };
+inline const char *kind_name(uint32_t k) {
+    return k == kOwnSeq ? "own-seq" : k == kRingSpace ? "ring-space" : k == kAdmission ? "vmid/admission" : k == kUserWait ? "WaitSeq" : k == kInternal ? "internal" : "?";
+}
+constexpr uint64_t kLogGapNs = 100000000ull;   // 100 ms
+constexpr uint32_t kLogMax   = 256u;
+struct LogGate { uint64_t lastNs; uint32_t printed; uint32_t suppressed; };
+// true = print now (and *suppressedBefore = the lines dropped since the previous printed one).
+inline bool log_gate(LogGate &g, uint64_t nowNs, uint32_t *suppressedBefore) {
+    if (g.printed >= kLogMax || (g.printed != 0u && nowNs >= g.lastNs && nowNs - g.lastNs < kLogGapNs)) { g.suppressed++; return false; }
+    *suppressedBefore = g.suppressed; g.suppressed = 0u; g.lastNs = nowNs; g.printed++;
+    return true;
+}
+
+}  // namespace n48wait
