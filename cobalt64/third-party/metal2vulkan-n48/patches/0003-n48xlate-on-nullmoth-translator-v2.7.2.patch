+#[test]
+fn native_raw_pointer_offset_survives_aggregate_helper_round_trip() {
+    // 80 bytes = word 20: the two float4 columns read through the typed `%mat` GEPs are
+    // words 20..=23 and 24..=27 (after the entry's own reads of words 4..=7 and 36).
+    assert_eq!(
+        raw_pointer_through_aggregate_helper_words(80),
+        ["4", "5", "6", "7", "36", "20", "21", "22", "23", "24", "25", "26", "27"]
+    );
+    // A different non-zero cursor must move the reads with it (not a fixed 80).
+    assert_eq!(
+        raw_pointer_through_aggregate_helper_words(208),
+        ["4", "5", "6", "7", "36", "52", "53", "54", "55", "56", "57", "58", "59"]
+    );
+}
