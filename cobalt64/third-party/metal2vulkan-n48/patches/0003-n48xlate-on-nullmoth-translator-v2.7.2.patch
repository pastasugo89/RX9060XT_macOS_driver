+/// How the call site in [`raw_call_offset_ll`] derives the byte cursor it hands to the helper.
+#[derive(Clone, Copy)]
+enum RawCallCursor {
+    /// `getelementptr i8, %buffer0, N` (N constant).
+    Const(u32),
+    /// `getelementptr i8, %buffer0, %w` with `%w` loaded from the buffer at run time.
+    Dynamic,
+}
+
+/// A kernel that hands a byte-offset constant-space pointer to a multi-block (LOOP) helper which
+/// reads the second column of a typed `%mat` through it. `helper_first` places the helper BEFORE the
+/// kernel in module order (the Core Image shape); `via_builder` routes the pointer through a
+/// single-block aggregate builder first, instead of passing it directly.
+fn raw_call_offset_ll(cursor: RawCallCursor, helper_first: bool, via_builder: bool) -> String {
+    let cursor_def = match cursor {
+        RawCallCursor::Const(n) => format!("  %cursor = getelementptr i8, ptr addrspace(2) %buffer0, i64 {n}"),
+        RawCallCursor::Dynamic => "  %w = load i32, ptr addrspace(2) %o148, align 4\n  %wi = zext i32 %w to i64\n  %cursor = getelementptr i8, ptr addrspace(2) %buffer0, i64 %wi".to_string(),
+    };
+    let call = if via_builder {
+        r#"  %built = call fastcc %S @build(ptr addrspace(1) %out, ptr addrspace(2) %buffer0, ptr addrspace(2) %alias, <2 x float> zeroinitializer)
+  %f0 = extractvalue %S %built, 0
+  %f1 = extractvalue %S %built, 1
+  %f2 = extractvalue %S %built, 2
+  %f3 = extractvalue %S %built, 3
+  %v = call fastcc <4 x float> @consume(%tex %f0, %smp %f1, ptr addrspace(2) %f2, <2 x float> %f3)"#
+    } else {
+        "  %v = call fastcc <4 x float> @consume(%tex zeroinitializer, %smp zeroinitializer, ptr addrspace(2) %alias, <2 x float> zeroinitializer)"
+    };
+    let kernel = format!(
+        r#"define void @k(ptr addrspace(2) %buffer0, ptr addrspace(1) %out) {{
+entry:
+  %o144 = getelementptr i8, ptr addrspace(2) %buffer0, i64 144
+  %l144 = load float, ptr addrspace(2) %o144, align 4
+  %o148 = getelementptr i8, ptr addrspace(2) %buffer0, i64 148
+{cursor_def}
+  %alias = bitcast ptr addrspace(2) %cursor to ptr addrspace(2)
+{call}
+  %first0 = extractelement <4 x float> %v, i64 0
+  %first = fadd float %first0, %l144
+  store float %first, ptr addrspace(1) %out, align 4
+  ret void
+}}
+"#
+    );
+    let helpers = r#"define internal fastcc %S @build(ptr addrspace(1) %a, ptr addrspace(2) %b, ptr addrspace(2) %p, <2 x float> %c) {
+entry:
+  %i0 = insertvalue %S poison, ptr addrspace(1) %a, 0, 0
+  %i1 = insertvalue %S %i0, ptr addrspace(2) %b, 1, 0
+  %i2 = insertvalue %S %i1, ptr addrspace(2) %p, 2
+  %i3 = insertvalue %S %i2, <2 x float> %c, 3
+  ret %S %i3
+}
+define internal fastcc <4 x float> @consume(%tex %t, %smp %s, ptr addrspace(2) %p, <2 x float> %c) {
+entry:
+  br label %loop
+loop:
+  %i = phi i32 [ 0, %entry ], [ %n, %loop ]
+  %acc = phi <4 x float> [ zeroinitializer, %entry ], [ %v, %loop ]
+  %c1 = getelementptr inbounds %mat, ptr addrspace(2) %p, i64 0, i32 0, i64 1
+  %v1 = load <4 x float>, ptr addrspace(2) %c1, align 16
+  %v = fadd <4 x float> %acc, %v1
+  %n = add i32 %i, 1
+  %done = icmp eq i32 %n, 4
+  br i1 %done, label %exit, label %loop
+exit:
+  ret <4 x float> %v
+}
+"#;
+    let (first, second) = if helper_first {
+        (helpers.to_string(), kernel)
+    } else {
+        (kernel, helpers.to_string())
+    };
+    format!(
+        r#"
+target triple = "spirv-unknown-vulkan1.2"
+%tex = type {{ ptr addrspace(1) }}
+%smp = type {{ ptr addrspace(2) }}
+%S = type {{ %tex, %smp, ptr addrspace(2), <2 x float> }}
+%mat = type {{ [2 x <4 x float>] }}
+{first}
+{second}
+!air.kernel = !{{!0}}
+!0 = !{{ptr @k, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4}}
+!3 = !{{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"float4", !"air.arg_name", !"buffer0"}}
+!4 = !{{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_name", !"float", !"air.arg_name", !"out"}}
+"#
+    )
+}
+
+/// Translate `ll` and return every constant word index of every `uint` storage-buffer access
+/// chain in program order, or the translation error.
+fn raw_call_offset_words(ll: &str, tag: &str) -> Result<Vec<String>, String> {
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_raw_call_offset_{}_{tag}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let result = crate::translate_sanitized_native(ll, Stage::Kernel, &tmp);
+    let _ = std::fs::remove_dir_all(&tmp);
+    let spv = result.map_err(|e| format!("{e}"))?;
+    let asm = disassemble(&spv).expect("disassemble");
+    assert!(!asm.contains(" Private"), "{asm}");
+    let words = |line: &str| {
+        line.split_whitespace()
+            .map(str::to_string)
+            .collect::<Vec<_>>()
+    };
+    let uint_ty = asm
+        .lines()
+        .map(words)
+        .find(|w| {
+            w.get(2).is_some_and(|op| op == "OpTypeInt")
+                && w.get(3..) == Some(&["32".into(), "0".into()][..])
+        })
+        .map(|w| w[0].clone())
+        .expect("uint type");
+    let uint_ptrs = asm
+        .lines()
+        .map(words)
+        .filter(|w| {
+            w.get(2).is_some_and(|op| op == "OpTypePointer")
+                && w.get(3).is_some_and(|sc| sc == "StorageBuffer")
+                && w.get(4) == Some(&uint_ty)
+        })
+        .map(|w| w[0].clone())
+        .collect::<Vec<_>>();
+    let constants = asm
+        .lines()
+        .map(words)
+        .filter(|w| w.get(2).is_some_and(|op| op == "OpConstant") && w.get(3) == Some(&uint_ty))
+        .map(|w| (w[0].clone(), w[4].clone()))
+        .collect::<HashMap<_, _>>();
+    Ok(asm
+        .lines()
+        .map(words)
+        .filter(|w| {
+            w.get(2).is_some_and(|op| op.ends_with("AccessChain")) && uint_ptrs.contains(&w[3])
+        })
+        .filter_map(|w| constants.get(w.last()?).cloned())
+        .collect())
+}
+
+fn expect_raw_call_offset_words(cursor_bytes: u32, helper_first: bool, via_builder: bool) {
+    let ll = raw_call_offset_ll(
+        RawCallCursor::Const(cursor_bytes),
+        helper_first,
+        via_builder,
+    );
+    let tag = format!("c{cursor_bytes}_{helper_first}_{via_builder}");
+    let first_col = cursor_bytes / 4 + 4;
+    let want = ["36"]
+        .into_iter()
+        .map(str::to_string)
+        .chain((first_col..first_col + 4).map(|w| w.to_string()))
+        .collect::<Vec<_>>();
+    match raw_call_offset_words(&ll, &tag) {
+        Ok(words) => assert_eq!(
+            words, want,
+            "cursor {cursor_bytes} helper_first {helper_first} builder {via_builder}"
+        ),
+        Err(e) => {
+            panic!("cursor {cursor_bytes} helper_first {helper_first} builder {via_builder}: {e}")
+        }
+    }
+}
