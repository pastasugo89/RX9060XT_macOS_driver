+// ----- ih_cpu_intr_off: 0.0.682, the storm guard's trip (navi48-interrupts=2) -----
+//
+// Clear IH_RB_CNTL.ENABLE_INTR and RPTR_REARM only (n48ih::cntl_after_trip): the IH stops signalling the host; RB_ENABLE, the writeback and
+// WPTR_OVERFLOW_ENABLE stay, so the ring keeps running exactly as in polled mode. Not upstream (Linux has no storm guard; the design is
+// Vermilion's phx_ih_irq.cpp irqFilter, which clears ENABLE_INTR alone).
+kern_return_t
+ih_cpu_intr_off(const DeviceContext &dev, IHContext &ih)
+{
+    if (!dev.ip.isResolved(IPBlock::OSSSYS)) return kIOReturnNotReady;
+    const uint32_t reg = SOC15_REG_OFFSET(dev, IPBlock::OSSSYS, IHRegs::IH_RB_CNTL);
+    const uint32_t before = RREG32(dev, reg);
+    WREG32(dev, reg, n48ih::cntl_after_trip(before));
+    ih.enable_cpu_intr = false;
+    IH_LOG("storm guard: IH_RB_CNTL %#010x -> %#010x (ENABLE_INTR and RPTR_REARM off; the ring stays enabled, drained by polling)",
+           before, RREG32(dev, reg));
+    return kIOReturnSuccess;
+}
