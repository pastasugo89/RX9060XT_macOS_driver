 }
 
 #ifdef HAVE_AMDGPU_DARWIN
+#include "darwin/ac_darwin_asic.h"   /* profiled PCI identity */
 /* macOS has no DRM devices to enumerate.  The one GPU is described by the
  * Darwin ac_drm backend, which needs the Navi48 kext's native client (or the
  * RADV_DARWIN_MOCK=1 / RADV_DARWIN_HOST_BO=1 stand-ins).  If the backend cannot
@@ -2999,15 +3000,15 @@ radv_darwin_enumerate_physical_devices(struct vk_instance *vk_instance)
    struct radv_instance *instance = (struct radv_instance *)vk_instance;
    struct radv_physical_device *pdev = NULL;
 
-   /* Fake PCI identity of the RX 9070 XT (vendor 0x1002, device 0x7550). */
+   /* PCI identity of the profiled ASIC (ac_darwin_asic.h: RX 9060 XT 0x7590 by default). */
    static char *nodes[DRM_NODE_MAX];
    static drmPciBusInfo bus_info;
    static drmPciDeviceInfo device_info = {
       .vendor_id = 0x1002,
-      .device_id = 0x7550,
-      .subvendor_id = 0x1002,
-      .subdevice_id = 0x0000,
-      .revision_id = 0xC0,
+      .device_id = ACD_PCI_DEVICE_ID,
+      .subvendor_id = ACD_PCI_SUBVENDOR,
+      .subdevice_id = ACD_PCI_SUBDEVICE,
+      .revision_id = ACD_PCI_REVISION,
    };
    drmDevice drm_device = {
       .nodes = nodes,
