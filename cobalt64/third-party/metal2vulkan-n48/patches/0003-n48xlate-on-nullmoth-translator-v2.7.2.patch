+// `+qnan`/`+inf`/`-inf` are type-agnostic spellings the parser stores as f32 bits; used as
+// `half` operands they must become the binary16 NaN/Inf, not be rejected.
+#[test]
+fn f32_bit_special_literals_in_half_code_become_binary16() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+
+define half @half_specials(half %x) {
+entry:
+  %a = fadd half %x, +qnan
+  %b = fadd half %a, +inf
+  %c = fadd half %b, -inf
+  ret half %c
+}
+"#;
+    let asm = disassemble(&emit_vulkan_spirv(ll).expect("native emit")).expect("disassemble");
+    // binary16 0x7e00 / 0x7c00 / 0xfc00; the disassembler prints them as NaN / inf / -inf.
+    assert!(asm.contains("  NaN\n"), "{asm}");
+    assert!(asm.contains("  inf\n"), "{asm}");
+    assert!(asm.contains("  -inf\n"), "{asm}");
+    assert!(!asm.contains("used as non-float type"), "{asm}");
+}
