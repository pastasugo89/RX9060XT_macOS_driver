+// Patch 0005 (Navi 44 only). CoreDisplay installs a timing only when the framebuffer publishes IOFBTimingRange
+// (coredisplay_re.md section 1). IOGraphics' own publisher is IONDRVFramebuffer::setInfoProperties
+// (IONDRVFramebuffer.cpp:1450-1470, cscGetTimingRanges). The property is IODisplayTimingRangeV2 (IOGraphicsTypes.h:796),
+// 0x138 bytes; the first 0xF0 bytes are the same as IODisplayTimingRangeV1. The range covers only the GOP timing,
+// 2560x1440 at 497.75 MHz, so the adoption is same-mode and no other mode is declared.
+void RDNA4FB::publishTimingRange() {
+	static_assert(sizeof(IODisplayTimingRangeV2) == 0x138, "IOFBTimingRange is the 0x138-byte V2 range");
+	IODisplayTimingRangeV2 r;
+	bzero(&r, sizeof(r));
+	r.version = kIOTimingRangeV2;
+
+	// Pixel clock: 497.75 MHz +/- 0.1 %, in Hz; the link-0 band in kHz. One link.
+	r.minPixelClock = 497250000ull;
+	r.maxPixelClock = 498250000ull;
+	r.maxPixelError = 500000;                                     // Hz, the same 0.1 % tolerance
+	r.minLink0PixelClock = 497250;
+	r.maxLink0PixelClock = 498250;
+	r.maxNumLinks = 1;
+
+	// Sync and signal: digital separate syncs only (H positive, V negative in the GOP timing).
+	r.supportedSyncFlags = kIORangeSupportsSeparateSyncs;
+	r.supportedSignalLevels = 0;                                  // analogue only
+	r.supportedSignalConfigs = 0;                                 // no interlaced CEA timing
+
+	// Rates and totals of the GOP timing: 2720 x 1525 at 497.75 MHz = 120.0 Hz, line rate 183.0 kHz.
+	r.minFrameRate = 119;      r.maxFrameRate = 121;              // Hz
+	r.minLineRate = 182800;    r.maxLineRate = 183200;            // Hz
+	r.maxHorizontalTotal = 2720;
+	r.maxVerticalTotal = 1525;
+
+	// Granularity: every count is a multiple of 1 (a 0 divisor would fail the range check).
+	r.charSizeHorizontalActive = 1;     r.charSizeHorizontalBlanking = 1;
+	r.charSizeHorizontalSyncOffset = 1; r.charSizeHorizontalSyncPulse = 1;
+	r.charSizeVerticalActive = 1;       r.charSizeVerticalBlanking = 1;
+	r.charSizeVerticalSyncOffset = 1;   r.charSizeVerticalSyncPulse = 1;
+	r.charSizeHorizontalBorderLeft = 1; r.charSizeHorizontalBorderRight = 1;
+	r.charSizeVerticalBorderTop = 1;    r.charSizeVerticalBorderBottom = 1;
+	r.charSizeHorizontalTotal = 1;      r.charSizeVerticalTotal = 1;
+
+	// Min = max: only the GOP timing (H 2560 + 160, sync 48/32; V 1440 + 85, sync 3/10). No borders.
+	r.minHorizontalActiveClocks = 2560;      r.maxHorizontalActiveClocks = 2560;
+	r.minHorizontalBlankingClocks = 160;     r.maxHorizontalBlankingClocks = 160;
+	r.minHorizontalSyncOffsetClocks = 48;    r.maxHorizontalSyncOffsetClocks = 48;
+	r.minHorizontalPulseWidthClocks = 32;    r.maxHorizontalPulseWidthClocks = 32;
+	r.minVerticalActiveClocks = 1440;        r.maxVerticalActiveClocks = 1440;
+	r.minVerticalBlankingClocks = 85;        r.maxVerticalBlankingClocks = 85;
+	r.minVerticalSyncOffsetClocks = 3;       r.maxVerticalSyncOffsetClocks = 3;
+	r.minVerticalPulseWidthClocks = 10;      r.maxVerticalPulseWidthClocks = 10;
+
+	// What the scanout carries: 8-bit RGB, sRGB / native RGB, SDR. Not YCbCr, not 10-bit, not HDR.
+	r.supportedPixelEncoding = kIOPixelEncodingRGB444;
+	r.supportedBitsPerColorComponent = kIOBitsPerColorComponent8;
+	r.supportedColorimetryModes = kIOColorimetryNativeRGB | kIOColorimetrysRGB;
+	r.supportedDynamicRangeModes = kIODynamicRangeSDR;
+
+	// Maximum bits per second of the topology (documented in IODisplayTimingRangeV2). Set to what the GOP timing
+	// needs on the wire: 497.75 MHz x 24 bpp x 10/8 (8b/10b) = 14.93 Gbit/s. It is not a link trait: the link
+	// is the one the GOP trained, and this value stays below HBR2 x4 (17.28 Gbit/s payload).
+	r.maxBandwidth = 14932500000ull;
+
+	// No DSC.
+
+	setProperty(kIOFBTimingRangeKey, &r, sizeof(r));
+	FBLOG("published IOFBTimingRange (%lu bytes): clock %llu..%llu Hz, GOP 2560x1440@120",
+	      (unsigned long)sizeof(r), (unsigned long long)r.minPixelClock, (unsigned long long)r.maxPixelClock);
+}
