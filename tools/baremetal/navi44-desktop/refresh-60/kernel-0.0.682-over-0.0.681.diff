--- a/src/amd/softrec_pure.h
+++ b/src/amd/softrec_pure.h
@@ -0,0 +1,149 @@
+//
+//  softrec_pure.h - 0.0.682: the PURE half of the opt-in soft recovery (boot-arg navi48-softrec=1, default OFF). No kernel header is included:
+//  tests/softrec682_test.cpp compiles this file and drives the decision and the kill sequence the kext runs (amd/native_s1c.cpp stall_handle).
+//
+//  What it adds to the G2 recovery (native_g2_pure.h, 0.0.627), only with the switch ON and only with navi48-multisession=1:
+//    1. A stall whose guilty submission (the owner of the oldest unretired seqno, native_g2_pure.h guilty_of) belongs to a user session that is
+//       NOT WindowServer first gets a WAVE KILL of that session's VMID: SQ_CMD = KILL | BROADCAST | CHECK_VMID | VM_ID, one write per ms for
+//       10 ms at most, each inside the RLC safe-mode bracket, until the stalled seqno retires. The session is poisoned before the first write.
+//       Nothing is reset.
+//    2. If the kill does not move the ring, today's G2 queue recovery (MES RESET of the GFX queue, reset_legacy_gfx) runs as before, within its
+//       per-boot budget. That is a queue reset, not a GPU reset.
+//    3. ONCE PER STALL: the guilty seqno that got (1) is remembered; a later detection of the same stall does nothing.
+//    4. If the guilty session is not WindowServer, the global HUNG latch is NEVER set by this stall, whatever (1) and (2) did: the guilty session
+//       is poisoned (its calls return Aborted), the others get Timeout from their own bounded waits and may retry. A stall owned by WindowServer,
+//       by the kernel, or by an unknown owner latches HUNG exactly as before (the switch changes nothing for them).
+//
+//  Sources:
+//    * Design: Vermilion src/vermilion-boot/PhxRecover.h and phx_recover.cpp (MIT, Copyright 2026 Vermilion contributors,
+//      https://github.com/leolivm/vermilion at 9a91901): the stall clock, "acted once per stall", the VMID-only kill value, 10 tries 1 ms apart,
+//      never VMID 0-7, never a broadcast without CHECK_VMID, nothing reset. Their register numbers are GC 11 absolute dword indices and were NOT
+//      used. MIT notice kept below.
+//    * Registers and encodings, GC 12.0.0, from Linux (MIT, Copyright Advanced Micro Devices, Inc.):
+//        linux-v7.3 include/asic_reg/gc/gc_12_0_0_offset.h:7315-7316  regSQ_CMD 0x111b, BASE_IDX 0
+//        linux-v7.3 include/asic_reg/gc/gc_12_0_0_sh_mask.h:23932-23945 SQ_CMD CMD [3:0], MODE [6:4], CHECK_VMID bit 7, VM_ID [31:28]
+//        linux-v7.3 include/asic_reg/gc/gc_12_0_0_sh_mask.h:9002-9025 GCVM_L2_PROTECTION_FAULT_STATUS_LO32 fields (VMID [23:20], ...)
+//        linux-v7.3 include/asic_reg/gc/gc_12_0_0_offset.h:2790        regGCVM_L2_PROTECTION_FAULT_STATUS_LO32 0x15d0 (read only, for the log)
+//        drm-kmod (Linux 6.14 base) amdgpu/gfx_v12_0.c:4617-4630 gfx_v12_0_ring_soft_recovery: CMD 3, MODE 1, CHECK_VMID 1, VM_ID vmid, written
+//            between amdgpu_gfx_rlc_enter_safe_mode / exit_safe_mode
+//        linux-v7.3 amdgpu/amdgpu_ring.c:450-477 amdgpu_ring_soft_recovery: 10 ms deadline, repeat until the fence signals
+//        the safe-mode handshake: RLC_SAFE_MODE (GC BASE_IDX 1, 0x0980), CMD bit 0, MESSAGE at bit 1 (gfx_v12_0_cg_pure.h, already used by 0.0.675)
+//      NOTE: Linux v7.3 no longer registers .soft_recovery for gfx_v12_0 (gfx_v12_0.c:5306-5323 uses MES queue reset, reset_kgq). The kill is
+//      therefore NOT what current upstream does on GC 12; it is what Linux 6.14 did. That is why it is opt-in and falls back to the MES reset.
+//
+//  MIT notice for the Vermilion design:
+//    Copyright (c) 2026 Vermilion contributors. Permission is hereby granted, free of charge, to any person obtaining a copy of this software
+//    and associated documentation files, to deal in the Software without restriction, subject to the condition that the above copyright
+//    notice and this permission notice shall be included in all copies or substantial portions of the Software. THE SOFTWARE IS PROVIDED
+//    "AS IS", WITHOUT WARRANTY OF ANY KIND.
+//
+#pragma once
+#include <stdint.h>
+
+namespace n48softrec {
+
+// ---- registers (GC 12.0.0) -----------------------------------------------------------------------------------------------------------------------
+constexpr uint32_t kSqCmd           = 0x111bu;   // GC BASE_IDX 0, write-only
+constexpr uint32_t kSqCmdBaseIdx    = 0u;
+constexpr uint32_t kRlcSafeMode     = 0x0980u;   // GC BASE_IDX 1
+constexpr uint32_t kRlcSafeModeBaseIdx = 1u;
+constexpr uint32_t kRlcCntl         = 0x4c00u;   // RLC_CNTL, GC BASE_IDX 1 (gc_12_0_0_offset.h), RLC_ENABLE_F32 bit 0
+constexpr uint32_t kRlcCntlBaseIdx  = 1u;
+constexpr uint32_t kFaultStatusLo32 = 0x15d0u;   // GCVM_L2_PROTECTION_FAULT_STATUS_LO32, GC BASE_IDX 0 (read for the log only; never written)
+
+// SQ_CMD fields (gc_12_0_0_sh_mask.h)
+constexpr uint32_t kSqCmdCmdKill       = 0x3u;       // CMD = SQ_IND_CMD_CMD_KILL
+constexpr uint32_t kSqCmdModeBroadcast = 0x1u << 4;  // MODE = SQ_IND_CMD_MODE_BROADCAST
+constexpr uint32_t kSqCmdCheckVmid     = 0x1u << 7;  // CHECK_VMID
+constexpr uint32_t kSqCmdVmidShift     = 28u;        // VM_ID [31:28]
+constexpr uint32_t kKillBase = kSqCmdCmdKill | kSqCmdModeBroadcast | kSqCmdCheckVmid;   // 0x93: the same encoding as GC 11 (gfx_v11_0) - checked
+static_assert(kKillBase == 0x93u, "SQ_CMD kill encoding");
+
+// The native VMIDs this kext lends to sessions (native_g2_pure.h vmid_of_slot: 8..15). Never 0-7 (the kernel's VMID 0 and the MES range).
+constexpr uint32_t kFirstUserVmid = 8u, kLastUserVmid = 15u;
+constexpr bool user_vmid(uint32_t v) { return v >= kFirstUserVmid && v <= kLastUserVmid; }
+// The kill value for one user VMID; 0 for anything else (the caller then does not write).
+constexpr uint32_t kill_value(uint32_t vmid) { return user_vmid(vmid) ? (kKillBase | (vmid << kSqCmdVmidShift)) : 0u; }
+
+constexpr uint32_t kKillTries = 10u, kKillStepUs = 1000u;   // amdgpu_ring_soft_recovery: 10 ms
+constexpr uint32_t kSafeModePollUs = 10000u;                // the bracket waits 10 ms at most here (Linux 100 ms); no ack -> no write
+
+// ---- the switch ------------------------------------------------------------------------------------------------------------------------------------
+constexpr bool latch_on(bool present, uint32_t value) { return present && value == 1u; }
+
+// ---- the decision --------------------------------------------------------------------------------------------------------------------------------------
+enum Verdict : uint32_t {
+    kOff = 0u,          // the switch is off (or multisession is off): today's stall_handle, unchanged
+    kNotUser = 1u,      // owner unknown, the kernel's probe, or not an open user session: today's path (latch)
+    kWsGuilty = 2u,     // WindowServer owns the stalled work: today's path (G2 refuses it, so HUNG is latched)
+    kActed = 3u,        // this stall (the same guilty seqno) already had its soft recovery: nothing more, NO latch
+    kBadVmid = 4u,      // the guilty session's VMID is not 8..15, or it is WindowServer's: no kill; the G2 reset may still run; NO latch
+    kKill = 5u,         // kill the guilty VMID's waves, then the G2 reset if needed; NO latch
+};
+inline const char *verdict_name(uint32_t v) {
+    return v == kOff ? "off" : v == kNotUser ? "owner not a user session" : v == kWsGuilty ? "WindowServer owns the stall"
+         : v == kActed ? "already acted on this stall" : v == kBadVmid ? "guilty VMID not killable" : v == kKill ? "kill" : "?";
+}
+struct Input {
+    bool on, multi;
+    bool guiltyKnown, userSession, guiltyIsWs;
+    uint64_t guiltySeq;
+    uint32_t guiltyVmid;
+    bool wsBound; uint32_t wsVmid;   // WindowServer's session holds a VMID now, and which
+    uint64_t actedSeq;               // the guilty seqno the last soft recovery acted on (0 = none this boot)
+};
+inline uint32_t decide(const Input &in) {
+    if (!in.on || !in.multi) return kOff;
+    if (!in.guiltyKnown || !in.userSession) return kNotUser;
+    if (in.guiltyIsWs) return kWsGuilty;
+    if (in.actedSeq != 0ull && in.actedSeq == in.guiltySeq) return kActed;
+    if (!user_vmid(in.guiltyVmid) || (in.wsBound && in.wsVmid == in.guiltyVmid)) return kBadVmid;
+    return kKill;
+}
+// Whether the stall may latch the global HUNG after the soft path ran. Only the verdicts that leave today's path in charge can latch.
+constexpr bool may_latch(uint32_t v) { return v == kOff || v == kNotUser || v == kWsGuilty; }
+// Whether the G2 queue reset may follow (only after a kill that did not move the ring, or when the VMID cannot be killed).
+constexpr bool g2_after(uint32_t v, bool killMoved) { return (v == kKill && !killMoved) || v == kBadVmid; }
+
+// ---- the fault status (logged, never written) ----------------------------------------------------------------------------------------------------
+struct Fault { uint32_t raw; bool more, mapping, rw; uint32_t walker, perm, cid, vmid; };
+constexpr Fault decode_fault(uint32_t st) {
+    return Fault{ st, (st & 1u) != 0u, ((st >> 8) & 1u) != 0u, ((st >> 18) & 1u) != 0u, (st >> 1) & 7u, (st >> 4) & 0xFu, (st >> 9) & 0x1FFu, (st >> 20) & 0xFu };
+}
+constexpr bool fault_latched(const Fault &f) { return f.mapping || f.perm != 0u; }
+
+// ---- the kill sequence --------------------------------------------------------------------------------------------------------------------------------
+// E provides: uint32_t rd(uint32_t baseIdx, uint32_t reg); void wr(uint32_t baseIdx, uint32_t reg, uint32_t v); void delayUs(uint32_t us);
+//             bool moved();   (the stalled seqno retired)
+enum KillResult : uint32_t { kKillMoved = 0u, kKillStuck = 1u, kKillBadVmid = 2u, kKillRlcOff = 3u, kKillSafeModeTimeout = 4u };
+inline const char *kill_name(uint32_t r) {
+    return r == kKillMoved ? "moved" : r == kKillStuck ? "stuck after 10 ms" : r == kKillBadVmid ? "bad VMID" : r == kKillRlcOff ? "RLC not running" : r == kKillSafeModeTimeout ? "RLC safe mode not acknowledged" : "?";
+}
+struct KillStats { uint32_t writes; uint32_t safeModePolls; };
+template <class E> inline uint32_t kill(E &e, uint32_t vmid, KillStats &st) {
+    st = KillStats{ 0u, 0u };
+    const uint32_t v = kill_value(vmid);
+    if (v == 0u) return kKillBadVmid;
+    const uint32_t cntl = e.rd(kRlcCntlBaseIdx, kRlcCntl);
+    if (cntl == 0xFFFFFFFFu || (cntl & 1u) == 0u) return kKillRlcOff;   // amdgpu_gfx_rlc_enter_safe_mode only acts with the RLC running
+    for (uint32_t i = 0; i < kKillTries; i++) {
+        // gfx_v12_0_set_safe_mode: CMD | 1 << MESSAGE, then wait for CMD to clear
+        e.wr(kRlcSafeModeBaseIdx, kRlcSafeMode, 0x1u | (1u << 1));
+        bool acked = false;
+        for (uint32_t p = 0; p < kSafeModePollUs; p++) {
+            const uint32_t r = e.rd(kRlcSafeModeBaseIdx, kRlcSafeMode);
+            if (r != 0xFFFFFFFFu && (r & 1u) == 0u) { acked = true; break; }
+            st.safeModePolls++;
+            e.delayUs(1u);
+        }
+        if (!acked) { e.wr(kRlcSafeModeBaseIdx, kRlcSafeMode, 0x1u); return kKillSafeModeTimeout; }   // gfx_v12_0_unset_safe_mode
+        e.wr(kSqCmdBaseIdx, kSqCmd, v);
+        st.writes++;
+        e.wr(kRlcSafeModeBaseIdx, kRlcSafeMode, 0x1u);                                                 // exit_safe_mode -> unset_safe_mode
+        e.delayUs(kKillStepUs);
+        if (e.moved()) return kKillMoved;
+    }
+    return kKillStuck;
+}
+
+}  // namespace n48softrec
