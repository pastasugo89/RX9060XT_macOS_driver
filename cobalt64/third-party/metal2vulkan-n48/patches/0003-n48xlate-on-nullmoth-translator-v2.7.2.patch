+#[test]
+fn native_raw_call_offset_reaches_loop_helper_defined_before_kernel() {
+    // 112 bytes + the second column (16 bytes) = words 32..=35; the helper's own typed offset 16
+    // must never collapse to the bare buffer's words 4..=7.
+    expect_raw_call_offset_words(112, true, true);
+}
+
+#[test]
+fn native_raw_call_offset_reaches_loop_helper_defined_after_kernel() {
+    expect_raw_call_offset_words(112, false, true);
+}
+
+#[test]
+fn native_raw_call_offset_reaches_loop_helper_passed_directly() {
+    expect_raw_call_offset_words(112, true, false);
+    expect_raw_call_offset_words(112, false, false);
+}
+
+#[test]
+fn native_raw_call_offset_80_reaches_loop_helper() {
+    expect_raw_call_offset_words(80, true, true);
+    expect_raw_call_offset_words(80, true, false);
+}
+
+#[test]
+fn native_raw_call_offset_is_delivered_or_refused_never_dropped() {
+    // A dynamic cursor, or any cursor the callee cannot receive, must either reach the helper's
+    // reads (a run-time-dependent access chain, never constant words 4..=7 of the bare buffer) or
+    // fail translation. It must never silently address the bare root.
+    for helper_first in [true, false] {
+        for via_builder in [true, false] {
+            let ll = raw_call_offset_ll(RawCallCursor::Dynamic, helper_first, via_builder);
+            let tag = format!("dyn_{helper_first}_{via_builder}");
+            if let Ok(words) = raw_call_offset_words(&ll, &tag) {
+                assert!(
+                    !["4", "5", "6", "7"].iter().all(|w| words.iter().any(|x| x == w)),
+                    "dynamic cursor dropped (helper_first {helper_first}, builder {via_builder}): {words:?}"
+                );
+            }
+        }
