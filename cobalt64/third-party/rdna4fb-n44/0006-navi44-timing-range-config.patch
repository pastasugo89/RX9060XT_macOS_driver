+// Returns nullptr if the range is acceptable, otherwise why it is refused. Every candidate passes through here.
+static const char *rdna4_range_refusal(const IODisplayTimingRangeV2 &r) {
+	if (r.version != 0 && r.version != kIOTimingRangeV2)
+		return "version is neither 0 nor 2";
+	if (r.minPixelClock == 0 || r.minPixelClock > r.maxPixelClock)
+		return "empty clock band";
+	if (r.maxPixelClock > kRDNA4ClockCapHz)
+		return "clock above 600 MHz";
+	if (r.minPixelClock > kRDNA4GopClockHz || r.maxPixelClock < kRDNA4GopClockHz)
+		return "the GOP clock (497.75 MHz) is outside the band";
+	if (r.minLink0PixelClock > r.maxLink0PixelClock)
+		return "empty link-0 band";
+	if (r.maxNumLinks > 1)
+		return "more than one link";
+	if (r.maxBandwidth > kRDNA4BandwidthCap)
+		return "bandwidth above HBR3 x4";
+	if (r.supportedPixelEncoding == 0 || (r.supportedPixelEncoding & ~kIOPixelEncodingRGB444))
+		return "encoding other than RGB444";
+	if (r.supportedBitsPerColorComponent == 0 || (r.supportedBitsPerColorComponent & ~kIOBitsPerColorComponent8))
+		return "bits per component other than 8";
+	if (r.supportedColorimetryModes == 0 ||
+	    (r.supportedColorimetryModes & ~(kIOColorimetryNativeRGB | kIOColorimetrysRGB)))
+		return "colorimetry other than native RGB or sRGB";
+	if (r.supportedDynamicRangeModes == 0 || (r.supportedDynamicRangeModes & ~kIODynamicRangeSDR))
+		return "dynamic range other than SDR";
+	return nullptr;
+}
