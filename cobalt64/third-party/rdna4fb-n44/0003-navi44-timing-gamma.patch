+// ---------------------------------------------------------------------------
+// IOFramebuffer — programmable timing and gamma (patch 0003, Navi 44 only)
+// ---------------------------------------------------------------------------
+// CoreDisplay's "InstallTiming ... FAILED ... 0xe00002c7" is the user-client method 17, extValidateDetailedTiming
+// (IOFramebuffer.cpp:4320), which returns the result of validateDetailedTiming; the base returns kIOReturnUnsupported
+// (IOFramebuffer.cpp:12910). matchFramebuffer (IOFramebuffer.cpp:7922) uses the same validate with an
+// IOFBDisplayModeDescription, then setDetailedTimings (base: IOFramebuffer.cpp:12918, unsupported), then
+// setDisplayMode(0xC0000000). Gamma: updateGammaTable (IOFramebuffer.cpp:3483-3521) ends in the base setGammaTable
+// (IOFramebuffer.cpp:12881 and :12890, unsupported): the "can't set device gamma (0xe00002c7)" line.
+// Only the GOP timing is accepted. Nothing is programmed: the scanout stays the GOP's.
+
+// The timing the GOP leaves on the SINK-A panel (the numbers of getTimingInfoForDisplayMode above): 2560x1440 with
+// clock 497.75 MHz, which is 120.0 Hz. The clock is compared with a 0.1 % tolerance, the rest exactly.
+static bool rdna4_is_gop_timing(const IODetailedTimingInformationV2 &v) {
+	const uint64_t want = 497750000ull;
+	const uint64_t tol  = want / 1000ull;
+	const uint64_t clk  = v.pixelClock;
+	const bool clockOk  = (clk + tol >= want) && (clk <= want + tol);
+	return clockOk
+	    && v.horizontalActive == 2560 && v.horizontalBlanking == 160
+	    && v.horizontalSyncOffset == 48 && v.horizontalSyncPulseWidth == 32
+	    && v.verticalActive == 1440 && v.verticalBlanking == 85
+	    && v.verticalSyncOffset == 3 && v.verticalSyncPulseWidth == 10
+	    && v.horizontalSyncConfig == kIOSyncPositivePolarity && v.verticalSyncConfig == 0;
+}
+
+// The framebuffer answers for its one mode and, on Navi 44, for the alias ids of the timings it accepted.
+bool RDNA4FB::ownsDisplayMode(IODisplayModeID displayMode) const {
+	if (displayMode == kRDNA4DisplayModeID)
+		return true;
+	if (!rdna4_is_navi44(pciDevice))
+		return false;
+	for (uint32_t i = 0; i < aliasModeCount; i++)
+		if (aliasModes[i] == displayMode)
+			return true;
+	return false;
+}
+
+// The description is an IOFBDisplayModeDescription (matchFramebuffer, and CoreDisplay's IOFBDisplayModeDescription) or a
+// bare IODetailedTimingInformationV2. Only the GOP timing is accepted, and the answer is that timing in canonical form
+// (IOFramebuffer.h: change the fields the driver cannot implement to the closest implementation). Anything else gets
+// kIOReturnUnsupported, the answer IOGraphics expects for a timing the driver cannot install.
+IOReturn RDNA4FB::validateDetailedTiming(void *description, IOByteCount descripSize) {
+	if (!rdna4_is_navi44(pciDevice))
+		return super::validateDetailedTiming(description, descripSize);
+	if (!description)
+		return kIOReturnBadArgument;
+
+	IOFBDisplayModeDescription *desc = nullptr;
+	IODetailedTimingInformationV2 *timing = nullptr;
+	if (descripSize == sizeof(IOFBDisplayModeDescription)) {
+		desc = static_cast<IOFBDisplayModeDescription *>(description);
+		timing = &desc->timingInfo.detailedInfo.v2;
+	} else if (descripSize == sizeof(IODetailedTimingInformationV2)) {
+		timing = static_cast<IODetailedTimingInformationV2 *>(description);
+	} else {
+		return kIOReturnBadArgument;
+	}
+
+	if (!rdna4_is_gop_timing(*timing)) {
+		// Log the 2560x1440 candidates (the 120 Hz one is the open question): a few lines per boot.
+		if (timing->horizontalActive == 2560 && timing->verticalActive == 1440)
+			FBLOG("validate: 2560x1440 candidate refused: clock %llu Hz, H %u+%u sync %u/%u, V %u+%u sync %u/%u, polarity %u/%u",
+			      (unsigned long long)timing->pixelClock,
+			      timing->horizontalActive, timing->horizontalBlanking,
+			      timing->horizontalSyncOffset, timing->horizontalSyncPulseWidth,
+			      timing->verticalActive, timing->verticalBlanking,
+			      timing->verticalSyncOffset, timing->verticalSyncPulseWidth,
+			      timing->horizontalSyncConfig, timing->verticalSyncConfig);
+		return kIOReturnUnsupported;
+	}
+
+	timing->pixelClock = 497750000ull;   // canonical clock (the candidate was within 0.1 %)
+	if (desc) {
+		desc->info.nominalWidth  = 2560;
+		desc->info.nominalHeight = 1440;
+		desc->info.refreshRate   = 120 << 16;   // 16.16 fixed point, as getInformationForDisplayMode
+		desc->info.maxDepthIndex = 0;
+		desc->info.flags         = kDisplayModeValidFlag | kDisplayModeSafeFlag;
+	}
+	FBLOG("validate: GOP timing 2560x1440@120 accepted");
+	return kIOReturnSuccess;
+}
+
+// The list of the detailed timings is replaced on each call (IOFramebuffer.h). Only the GOP timings are kept, as aliases
+// of the one mode. Nothing is reprogrammed.
+IOReturn RDNA4FB::setDetailedTimings(OSArray *array) {
+	if (!rdna4_is_navi44(pciDevice))
+		return super::setDetailedTimings(array);
+	aliasModeCount = 0;
+	if (!array)
+		return kIOReturnSuccess;
+	const unsigned count = array->getCount();
+	for (unsigned i = 0; i < count; i++) {
+		OSData *data = OSDynamicCast(OSData, array->getObject(i));
+		if (!data || data->getLength() != sizeof(IODetailedTimingInformationV2))
+			continue;
+		const IODetailedTimingInformationV2 *t =
+		    static_cast<const IODetailedTimingInformationV2 *>(data->getBytesNoCopy());
+		const IODisplayModeID id = (IODisplayModeID)t->__reservedA[0];   // detailedTimingModeID
+		if (!rdna4_is_gop_timing(*t) || id == 0 || id == kRDNA4DisplayModeID ||
+		    aliasModeCount >= kRDNA4MaxAliasModes)
+			continue;
+		aliasModes[aliasModeCount++] = id;
+	}
+	FBLOG("setDetailedTimings: %u alias mode(s) of the GOP timing", aliasModeCount);
+	return kIOReturnSuccess;
+}
+
+// Gamma: the table is accepted and not programmed. This framebuffer drives no gamma LUT, and the GOP scanout keeps its
+// own. Nothing is written to hardware.
+IOReturn RDNA4FB::setGammaTable(UInt32 channelCount, UInt32 dataCount,
+                                UInt32 dataWidth, void *data) {
+	if (!rdna4_is_navi44(pciDevice))
+		return super::setGammaTable(channelCount, dataCount, dataWidth, data);
+	return kIOReturnSuccess;
+}
+
+IOReturn RDNA4FB::setGammaTable(UInt32 channelCount, UInt32 dataCount,
+                                UInt32 dataWidth, void *data, bool syncToVBL) {
+	if (!rdna4_is_navi44(pciDevice))
+		return super::setGammaTable(channelCount, dataCount, dataWidth, data, syncToVBL);
+	return kIOReturnSuccess;
+}
