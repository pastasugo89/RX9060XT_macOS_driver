+//
+//  ih_storm_pure.h - 0.0.682: the PURE half of the guarded interrupt mode (boot-arg navi48-interrupts=2). No kernel header is included:
+//  tests/ih_storm682_test.cpp compiles this file and drives the very functions the kext calls (Navi48Bringup.cpp handleInterrupt,
+//  amd/ih_v7_0.cpp ih_get_wptr, amd/native_s1c.cpp wait_relax via wait_pure.h).
+//
+//  Three pieces:
+//    1. The mode the boot-arg selects. 0 = polled (the production boot-args), 1 = the MSI path of 0.0.35 exactly as before (also the value
+//       when the boot-arg is absent, as in every build since 0.0.35), 2 = the MSI path with the storm guard below and EOP-woken fence waits.
+//    2. The storm guard: a 1 s window that counts handler runs, drained IH entries and ring overflows. Past any limit the guard trips ONCE per
+//       boot; the kext then clears IH_RB_CNTL.ENABLE_INTR and RPTR_REARM (the IH stops signalling the host, the ring keeps running with
+//       RB_ENABLE=1 and WPTR_OVERFLOW_ENABLE=1, as in polled mode), disables the event source and turns the EOP wake off. Fence waits go back
+//       to polling. Nothing is re-armed for the rest of the boot.
+//    3. The IH v7 overflow resync (rptr = the oldest vector not overwritten) and when the EOP wake may be used.
+//
+//  Design source: Vermilion src/vermilion-boot/phx_ih_irq.cpp (MIT, Copyright 2026 Vermilion contributors; https://github.com/leolivm/vermilion
+//  at 9a91901): a 1 s window, more than 50,000 interrupts disables ENABLE_INTR; overflow skips to wptr + 32 and pulses WPTR_OVERFLOW_CLEAR; an
+//  EOP vector wakes the fence waiters. Their code targets IH 6 (Navi 31) with absolute register numbers; NO register value was taken from it.
+//  The register fields here are IH 7 from Linux v7.3 (MIT, Copyright Advanced Micro Devices, Inc.):
+//    drivers/gpu/drm/amd/include/asic_reg/oss/osssys_7_0_0_sh_mask.h  IH_RB_WPTR__RB_OVERFLOW (bit 0), IH_RB_WPTR__OFFSET (bits 17:2),
+//                                                                     IH_RB_CNTL__ENABLE_INTR (bit 17), IH_RB_CNTL__RPTR_REARM (bit 21)
+//    drivers/gpu/drm/amd/amdgpu/ih_v7_0.c:453-491   ih_v7_0_get_wptr: shadow -> MMIO re-read -> rptr = (wptr + 32) & ptr_mask -> CLEAR pulse
+//    drivers/gpu/drm/amd/amdgpu/amdgpu_ih.c:209-240 amdgpu_ih_process: bounded passes (AMDGPU_IH_MAX_NUM_IVS) and restart_ih
+//  MIT notice for the Vermilion design (kept as their licence asks):
+//    Copyright (c) 2026 Vermilion contributors. Permission is hereby granted, free of charge, to any person obtaining a copy of this software
+//    and associated documentation files, to deal in the Software without restriction, subject to the condition that the above copyright
+//    notice and this permission notice shall be included in all copies or substantial portions of the Software. THE SOFTWARE IS PROVIDED
+//    "AS IS", WITHOUT WARRANTY OF ANY KIND.
+//
+#pragma once
+#include <stdint.h>
+
+namespace n48ih {
+
+// ---- 1. the mode -------------------------------------------------------------------------------------------------------------------------------
+enum Mode : uint32_t { kPolled = 0u, kMsi = 1u, kMsiGuarded = 2u };
+// present = PE_parse_boot_argn found navi48-interrupts. Absent: 1 (the 0.0.35 default, unchanged). 0: polled. 2: guarded. Any other value: 1 (as
+// before 0.0.682, where every non-zero value armed the plain MSI path).
+constexpr uint32_t mode_of(bool present, uint32_t value) {
+    return !present ? (uint32_t)kMsi : value == 0u ? (uint32_t)kPolled : value == 2u ? (uint32_t)kMsiGuarded : (uint32_t)kMsi;
+}
+constexpr bool wants_msi(uint32_t mode) { return mode != kPolled; }
+constexpr bool guarded(uint32_t mode) { return mode == kMsiGuarded; }
+
+// ---- 2. the storm guard ------------------------------------------------------------------------------------------------------------------------------
+constexpr uint64_t kStormWindowNs   = 1000000000ull;   // Vermilion's window (phx_ih_irq.cpp irqEnable: nanoseconds_to_absolutetime(1000000000))
+constexpr uint32_t kStormMaxIrqs    = 50000u;          // Vermilion's limit (irqFilter: ++gIrqWinCnt > 50000)
+// Ours on top: drained entries (a single MSI may cover a whole ring) and overflows (the host is not keeping up). 200,000 entries is 24 full
+// 256 KiB rings per second; four overflows in one second means the ring was lost four times.
+constexpr uint32_t kStormMaxEntries = 200000u;
+constexpr uint32_t kStormMaxOverflows = 4u;
+enum Trip : uint32_t { kTripNone = 0u, kTripIrqs = 1u, kTripEntries = 2u, kTripOverflows = 3u };
+struct Storm {
+    uint64_t winStartNs;
+    uint32_t irqs, entries, overflows;   // in the current window
+    uint32_t trip;                       // the reason of the trip, kTripNone until it tripped (sticky for the boot)
+    uint64_t trippedAtNs;
+    uint64_t emptyRuns;                  // handler runs that drained nothing (whole boot)
+};
+enum Verdict : uint32_t { kKeep = 0u, kTripNow = 1u, kAlreadyTripped = 2u };
+// One handler run: `entries` drained, `overflowsTotal` = ih.overflows_seen after the drain (a running total; the guard keeps the delta).
+// Returns kTripNow exactly once (the run that crosses a limit); afterwards kAlreadyTripped.
+inline uint32_t storm_note(Storm &s, uint64_t nowNs, uint32_t entries, uint32_t overflowsInRun) {
+    if (s.trip != kTripNone) return kAlreadyTripped;
+    if (s.winStartNs == 0ull || nowNs < s.winStartNs || nowNs - s.winStartNs >= kStormWindowNs) {
+        s.winStartNs = nowNs == 0ull ? 1ull : nowNs; s.irqs = 0u; s.entries = 0u; s.overflows = 0u;
+    }
+    s.irqs++;
+    s.entries = entries > 0xFFFFFFFFu - s.entries ? 0xFFFFFFFFu : s.entries + entries;
+    s.overflows += overflowsInRun;
+    if (entries == 0u) s.emptyRuns++;
+    const uint32_t why = s.irqs > kStormMaxIrqs ? (uint32_t)kTripIrqs : s.entries > kStormMaxEntries ? (uint32_t)kTripEntries
+                       : s.overflows >= kStormMaxOverflows ? (uint32_t)kTripOverflows : (uint32_t)kTripNone;
+    if (why == kTripNone) return kKeep;
+    s.trip = why; s.trippedAtNs = nowNs;
+    return kTripNow;
+}
+inline const char *trip_name(uint32_t t) {
+    return t == kTripIrqs ? "more than 50000 interrupts in 1 s" : t == kTripEntries ? "more than 200000 IH entries in 1 s"
+         : t == kTripOverflows ? "4 IH ring overflows in 1 s" : "none";
+}
+// The per-source census the trip log prints (Vermilion keeps the same 16 client:src keys in gIhKey / gIhCnt).
+constexpr uint32_t kKeys = 16u;
+struct Census { uint16_t key[kKeys]; uint32_t cnt[kKeys]; uint32_t other; };
+inline void census_note(Census &c, uint8_t client, uint8_t src) {
+    const uint16_t k = (uint16_t)(((uint16_t)client << 8) | src);
+    for (uint32_t i = 0; i < kKeys; i++) {
+        if (c.cnt[i] != 0u && c.key[i] == k) { c.cnt[i]++; return; }
+        if (c.cnt[i] == 0u) { c.key[i] = k; c.cnt[i] = 1u; return; }
+    }
+    c.other++;
+}
+
+// IH_RB_CNTL bits the trip clears (osssys_7_0_0_sh_mask.h: ENABLE_INTR 0x00020000, RPTR_REARM 0x00200000). RB_ENABLE (bit 0),
+// WPTR_OVERFLOW_ENABLE (bit 16) and the writeback stay as they are: the ring keeps running exactly as in polled mode.
+constexpr uint32_t kCntlEnableIntr = 1u << 17;
+constexpr uint32_t kCntlRptrRearm  = 1u << 21;
+constexpr uint32_t cntl_after_trip(uint32_t cntl) { return cntl & ~(kCntlEnableIntr | kCntlRptrRearm); }
+
+// ---- 3a. the overflow resync (ih_v7_0_get_wptr) ---------------------------------------------------------------------------------------------------
+constexpr uint32_t kWptrOverflow = 1u;   // IH_RB_WPTR__RB_OVERFLOW_MASK
+constexpr bool wptr_overflowed(uint32_t w) { return (w & kWptrOverflow) != 0u; }
+// The read pointer after an overflow: the vector after wptr is the oldest one not overwritten. Linux: (wptr + 32) & ptr_mask with the
+// overflow bit cleared. Ours also aligns wptr down to the 32-byte vector first, so a damaged wptr can never put rptr between two vectors (the
+// drain could then never meet wptr and would walk a whole lap).
+constexpr uint32_t rptr_after_overflow(uint32_t wptrRaw, uint32_t ptrMask) { return (((wptrRaw & ~kWptrOverflow) & ~31u) + 32u) & ptrMask; }
+// The usable wptr: masked (Linux `wptr & ih->ptr_mask`), aligned down to a vector.
+constexpr uint32_t wptr_usable(uint32_t wptrRaw, uint32_t ptrMask) { return (wptrRaw & ptrMask) & ~31u; }
+
+// ---- 3b. the EOP wake (the wait steps themselves are in wait_pure.h) ------------------------------------------------------------------------
+// The EOP wake is used only when every condition holds: mode 2, the MSI armed, the IH ring delivering interrupts, the storm guard not tripped.
+constexpr bool eop_wake_on(uint32_t mode, bool armed, bool cpuIntr, bool tripped) { return guarded(mode) && armed && cpuIntr && !tripped; }
+// The kernel seqno RELEASE_MEM asks for an interrupt (INT_SEL 2, Linux gfx_v12_0_ring_emit_fence with AMDGPU_FENCE_FLAG_INT) only while the
+// EOP wake is on; otherwise INT_SEL 0 exactly as before.
+constexpr uint32_t kIntSelNone = 0u, kIntSelSendInt = 2u;   // amdgpu_pm4.h kPM4RMIntSelNone / kPM4RMIntSelSendInt
+constexpr uint32_t seq_int_sel(bool eopWake) { return eopWake ? kIntSelSendInt : kIntSelNone; }
+
+}  // namespace n48ih
