 #define ACD_DRM_MAJOR AC_AMDGPU_DRM_MAJOR
 #define ACD_DRM_MINOR AC_AMDGPU_DRM_MINOR
 
-/* amdgpu.ids: 7550,C0 */
-#define ACD_MARKETING_NAME "AMD Radeon RX 9070 XT"
+#include "ac_darwin_asic.h"   /* ACD_CANNED_NAME, ACD_MARKETING_NAME */
 
 #define ACD_METADATA_MAX 256
 /* How long a submit blocks on a dependency that was never submitted (WAIT_FOR_SUBMIT). */
@@ -257,7 +256,7 @@ acd_device_initialize(uint32_t *drm_major, uint32_t *drm_minor, acd_device_handl
    if (!dev)
       return -ENOMEM;
 
-   dev->canned = find_canned("gfx1201");
+   dev->canned = find_canned(ACD_CANNED_NAME);
    if (!dev->canned) {
       free(dev);
       return -ENODEV;
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index 1730aab48d0..cafbd38c5b4 100644
